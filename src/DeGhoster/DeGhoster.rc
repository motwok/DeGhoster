#include <windows.h>
#include "resource.h"

// Compile all resources under one language so muirct sees a single-language
// binary it can split into the LN module and the .mui satellites.
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDI_APP ICON "..\\..\\assets\\app.ico"

// 1 = CREATEPROCESS_MANIFEST_RESOURCE_ID, 24 = RT_MANIFEST
1 24 "app.manifest"

// en-US string table (fallback baked into the exe)
#include "strings_en.rc"

// VERSIONINFO (resource type 16 -> stays in the language-neutral LN module;
// rcconfig.xml only localizes the STRINGTABLE). Fields for this binary:
#define VER_FILETYPE             VFT_APP
#define VER_INTERNALNAME_STR     "DeGhoster"
#define VER_ORIGINALFILENAME_STR "DeGhoster.exe"
#define VER_FILEDESCRIPTION_STR  "DeGhoster - invisible ghost-window neutralizer"
#include "../version.rc"
