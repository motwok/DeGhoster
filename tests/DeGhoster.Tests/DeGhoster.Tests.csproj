<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Integration tests for DeGhoster. They launch the C++ artifacts from build\
    (GhostSim + DeGhoster) and assert that a ghost window gets neutralized
    (DWMWA_CLOAKED). Requires an interactive desktop with DWM. Run after the
    native build (cmake workflows / build.ps1).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
