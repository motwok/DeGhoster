# Central build output directory
/build/

# Fallback (in case something is built locally after all)
[Bb]in/
[Oo]bj/
*.user

# Native (MSVC) intermediate artifacts
*.obj
*.lib
*.exp
*.ilk

*.log

# Generated by cmake/Version.cmake (GitVersion)
/src/Version.h

# Packaging output (ZIP / MSI artifacts)
/dist/

# Coverage reports (OpenCppCoverage)
/coverage/
